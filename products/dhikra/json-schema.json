{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dhikra/schema/1.1",
  "title": "Dhikra Content Package 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "items"],
  "properties": {
    "schema_version": { "enum": ["1.1", "1.1.0"] },
    "language": { "type": "string", "minLength": 2, "maxLength": 20 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "text", "source", "main_topic"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$", "maxLength": 120 },
          "translation_group": { "type": "string", "pattern": "^[a-z0-9_-]+$", "maxLength": 120 },
          "type": { "enum": ["quran", "hadith", "prayer", "wisdom", "story"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 110 },
          "text": { "type": "string", "minLength": 1, "maxLength": 900 },
          "translation": { "type": "string", "maxLength": 620 },
          "reflection": { "type": "string", "maxLength": 260 },
          "speaker": { "type": "string", "maxLength": 140 },
          "source": { "type": "string", "minLength": 1, "maxLength": 220 },
          "main_topic": { "type": "string", "minLength": 1, "maxLength": 120 },
          "topics": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true },
          "short_code": { "type": "string", "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}$" },
          "status": { "enum": ["draft", "pending", "publish", "future"] }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "quran" } } }, "then": { "required": ["translation"] } },
          { "if": { "properties": { "type": { "enum": ["hadith", "prayer"] } } }, "then": { "required": ["translation", "speaker"] } },
          { "if": { "properties": { "type": { "const": "wisdom" } } }, "then": { "anyOf": [ { "required": ["speaker"] }, { "required": ["source"] } ] } }
        ]
      }
    }
  }
}
