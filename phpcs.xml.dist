<?xml version="1.0"?>
<ruleset name="Tazkar">
    <description>WordPress Coding Standards for Tazkar.</description>
    <file>tazkar.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
</ruleset>
